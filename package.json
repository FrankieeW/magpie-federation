{
  "name": "magpie-federation",
  "version": "0.5.0",
  "description": "Bring remote Magpie providers and MCP servers into native lists with their source identities.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./index.ts",
  "bin": {
    "magpie-federation": "./scripts/federation.ts"
  },
  "files": [
    "index.ts",
    "src/federation",
    "src/machine/cli.ts",
    "src/machine/locate.ts",
    "src/server/owner.ts",
    "page",
    "scripts/federation.ts",
    "README.md"
  ],
  "scripts": {
    "connect": "bun scripts/federation.ts connect",
    "sync": "bun scripts/federation.ts sync",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/ui/tsconfig.json",
    "e2e": "bun scripts/e2e-federation.ts"
  },
  "engines": {
    "bun": ">=1.2.0",
    "magpie": ">=0.1.3285"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "routing",
    "federation",
    "mcp",
    "llm-gateway"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrankieeW/magpie-federation.git"
  },
  "homepage": "https://github.com/FrankieeW/magpie-federation#readme",
  "bugs": {
    "url": "https://github.com/FrankieeW/magpie-federation/issues"
  },
  "magpie": {
    "name": "远端连接",
    "page": {
      "title": "Remote Dashboard",
      "titles": { "zh": "远端看板" },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": { "port": 3487, "option": "port" }
    },
    "summary": {
      "en": "Import each remote provider separately with its server and source, and connect MCP as a hub or as separate namespaces.",
      "zh": "将远端各家供应商分别接入原生列表，保留服务器与来源。MCP 可整台接入，也可按命名空间分别接入。"
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "playwright-core": "^1.65.0",
    "typescript": "5"
  }
}
